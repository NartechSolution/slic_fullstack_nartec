<%- include('../layouts/header') %>

<!-- Main Content -->
<table
  role="presentation"
  style="
    width: 100%;
    max-width: 600px;
    margin: 30px auto;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 51, 102, 0.1);
    overflow: hidden;
    border: 1px solid #e0e7ff;
  "
  class="mobile-container"
>
  <tr>
    <td style="padding: 50px 40px" class="mobile-padding small-mobile-padding">
      <!-- Greeting -->
      <p
        style="
          color: #1e3a5f;
          font-size: 16px;
          margin: 0 0 20px 0;
          line-height: 1.6;
        "
      >
        Dear <%= supplierName %>,
      </p>

      <p
        style="
          color: #1e3a5f;
          font-size: 15px;
          margin: 0 0 25px 0;
          line-height: 1.6;
        "
      >
        We received a request to reset the password of your SLIC Suppliers
        Portal account. Use the one time password (OTP) below to continue.
      </p>

      <!-- OTP Box -->
      <div
        style="
          background-color: #f8fafb;
          border: 1px dashed #003366;
          border-radius: 10px;
          padding: 25px 20px;
          margin: 25px 0;
          text-align: center;
        "
      >
        <p
          style="
            color: #6b7280;
            font-size: 13px;
            margin: 0 0 12px 0;
            letter-spacing: 1px;
            text-transform: uppercase;
          "
        >
          Your verification code
        </p>
        <p
          style="
            color: #003366;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 10px;
            margin: 0;
            font-family: 'Courier New', Courier, monospace;
          "
          class="mobile-title"
        >
          <%= otp %>
        </p>
      </div>

      <!-- Expiry notice -->
      <div
        style="
          background-color: #fffbeb;
          border-left: 4px solid #f59e0b;
          padding: 15px 20px;
          margin: 25px 0;
          border-radius: 6px;
        "
      >
        <p style="color: #92400e; font-size: 14px; margin: 0; line-height: 1.6">
          This code expires in <strong><%= expiryMinutes %> minutes</strong> and
          can only be used once.
        </p>
      </div>

      <p
        style="
          color: #6b7280;
          font-size: 14px;
          margin: 25px 0 0 0;
          line-height: 1.6;
        "
      >
        If you did not request a password reset, you can safely ignore this
        email — your password will remain unchanged. Never share this code with
        anyone; SLIC staff will never ask you for it.
      </p>

      <!-- Closing -->
      <p
        style="
          color: #1e3a5f;
          font-size: 15px;
          margin: 30px 0 0 0;
          line-height: 1.6;
        "
      >
        Best regards,<br />
        <strong>SLIC Team</strong><br />
        Saudi Leather Industries Company
      </p>
    </td>
  </tr>
</table>

<%- include('../layouts/footer') %>
